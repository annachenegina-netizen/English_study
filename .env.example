# Эти переменные задаются в Vercel: Settings -> Environment Variables

# Ключ Gemini (бесплатно на https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Модель Gemini. Можно не задавать — тогда берётся значение по умолчанию из api/_lib/gemini.js
GEMINI_MODEL=

# Пароль для входа в тренажёр (придумай любой)
APP_PASSWORD=

# Эти две Vercel добавит сам, когда подключишь базу Upstash Redis (Storage -> Create Database)
KV_REST_API_URL=
KV_REST_API_TOKEN=
